<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical">
    <TextView
        android:id="@+id/widget_reminder_title"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:text="@string/widget_reminders_title"
        android:contentDescription="@string/widget_open_daykit"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/text_primary"
        android:textSize="16sp"
        android:textStyle="bold" />
    <ListView
        android:id="@+id/widget_reminder_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@color/widget_stroke"
        android:dividerHeight="1dp"
        android:scrollbars="none" />
    <TextView
        android:id="@+id/widget_reminder_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="@string/widget_reminders_empty"
        android:textColor="@color/text_muted"
        android:textSize="14sp" />
</LinearLayout>
