<?xml version="1.0" encoding="utf-8"?>
<!--
    Nothing leaves the device through Android backup or phone-to-phone transfer.
    The DB, vault files and wrapped keys only open with this device's Keystore keys,
    so a copy on a new phone is unreadable (it would land on the "can't open data"
    screen instead of a fresh start). Users move data with DayKit's own encrypted
    backup. allowBackup="false" alone does not stop device transfer on Android 12+.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
